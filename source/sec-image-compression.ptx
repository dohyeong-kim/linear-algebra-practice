      <video source="/image-compression-animations/3-by-3-grayscale.mp4"/>
    </figure>
    <aside>
      <p>
        유의미한 특잇값은 3개이다.
      </p>
    </aside>
  </example>
  <example xml:id="ex-image-compression-cow">
