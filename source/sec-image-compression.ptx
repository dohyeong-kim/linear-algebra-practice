  <example xml:id="ex-image-compression-shaded-tree">
    <title>그늘 속 나무 사진 압축</title>
    <figure xml:id="fig-shaded-tree-large">
      <caption>그늘 속 나무 사진</caption>
      <image source="/image-compression-images/shaded-tree.jpg" width="75%"/>
    </figure>
    <figure xml:id="fig-shaded-tree-compression">
