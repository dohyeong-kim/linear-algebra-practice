        </image>
      </figure>
      <figure xml:id="fig-demonstration-pca-food-k-3-xy">
        <caption><m>k=3</m>, <m>S_2</m>방향에서</caption>
        <image source="food-3d-xy.png">
          <shortdescription>3차원 주성분분석 결과 - xy축 방향</shortdescription>
        </image>
      </figure>
      <figure xml:id="fig-demonstration-pca-food-k-3">
        <caption><m>k=3</m>, 다른 방향</caption>
        <image source="food-3d.png">
          <shortdescription>3차원 주성분분석 결과 - 다른 방향</shortdescription>
        </image>
      </figure>
    </example>

</section>